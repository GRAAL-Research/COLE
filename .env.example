# HuggingFace token (required for accessing the private graalul/COLE dataset)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Backend port (default: 8000)
INTERNAL_API_PORT=7861

# Exposed port (default: 7860, used by HuggingFace Spaces)
PORT=7860

# HuggingFace cache directory
HF_HOME=/app/.cache
HF_DATASETS_CACHE=/app/.cache
